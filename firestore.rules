rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid} {
      match /duas/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
          && request.resource.data.text is string && request.resource.data.text.size() <= 5000
          && request.resource.data.kind in ['required', 'optional']
          && request.resource.data.order is number;
      }
      match /completions/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['duaId', 'dateKey', 'completedAt'])
          && id == request.resource.data.duaId + '_' + request.resource.data.dateKey;
      }
      match /settings/{id} {
        allow read: if owner(uid);
        allow write: if owner(uid) && id in ['rotation', 'prefs']
          && (id != 'rotation' || request.resource.data.activeIds.size() <= 5);
      }
    }
  }
}
